# Model provider
JARVIS_MODEL_PROVIDER=openrouter
JARVIS_MODEL=anthropic/claude-sonnet-4
JARVIS_FALLBACK_MODEL=anthropic/claude-sonnet-4
OPENROUTER_API_KEY=

# Runtime
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8000
JARVIS_DATABASE_URL=sqlite:///./storage/jarvis.db
JARVIS_LOG_LEVEL=INFO

# Browser
JARVIS_BROWSER_HEADLESS=true
JARVIS_BROWSER_EXECUTABLE_PATH=

# Security
JARVIS_REQUIRE_CONFIRMATION=true
JARVIS_ALLOWED_TOOLS=web,browser,memory,scheduler

# Voice (provider-specific adapters can be added later)
JARVIS_STT_PROVIDER=local
JARVIS_TTS_PROVIDER=local
